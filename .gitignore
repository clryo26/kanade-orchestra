# Secrets and local configuration
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.ruff_cache/
.ruff-cache-local/
.mypy_cache/
.tmp/
.coverage
coverage/
htmlcov/

# Node
node_modules/
npm-debug.log*

# Browser test artefacts
test-results/
playwright-report/
blob-report/

# uv cache
.uv-cache/
.uv-cache-local/

# Runtime-generated files
src/uploads/*
!src/uploads/.gitkeep
logs/*
!logs/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local archives
*.zip
*.tar
*.tar.gz
dist/source-share/

# Note: .git/ is repository metadata and must never be included in shared ZIP.

# Local JSON is no longer the production data source
src/data/*.json
!src/data/.gitkeep

# Database backups
/db/backups/
*.dump
*.sql.gz
