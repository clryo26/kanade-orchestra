# Cloud Run / local server
PORT=8080
LOG_LEVEL=INFO

# Optional CORS. Leave empty to allow all origins while testing.
# CORS_ORIGINS=https://example.com,https://example.run.app
CORS_ORIGINS=

# Google Cloud Storage
GOOGLE_CLOUD_STORAGE_BUCKET=your-gcs-bucket-name
GOOGLE_CLOUD_STORAGE_PUBLIC=false
GOOGLE_CLOUD_STORAGE_DATA_PREFIX=app-data

# Database / Cloud SQL (default data source)
# Data backend. Production default is DB. Use DATA_BACKEND=local only for emergency local development.
DATA_BACKEND=db
DB_REQUIRED=true
# LOCAL_JSON_FALLBACK_ENABLED=false
# DB_URL=postgresql://user:password@host:5432/dbname
# DB_HOST=127.0.0.1
# DB_NAME=orchestra
# DB_USER=orchestra
# DB_PASSWORD=change-me
# DB_SSLMODE=disable
# DB_DATA_MODE=json

# Startup performance
# true: preload core collections on startup / false: load lazily on first request
STARTUP_PRELOAD_ENABLED=true
# Comma-separated collection names. Leave empty to use default core collections.
STARTUP_PRELOAD_COLLECTIONS=
