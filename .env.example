# -----------------------------------------------------------------------------
# Runtime Profile / Cloud Run
# -----------------------------------------------------------------------------
APP_ENV=dev
PORT=8080
LOG_LEVEL=INFO
UV_SYSTEM_CERTS=true
DEFAULT_TENANT_ID=default

# Cloud Run metadata (usually auto-injected in Cloud Run)
K_REVISION=
CLOUD_RUN_REVISION=

# Diagnostic endpoint controls
DIAGNOSTIC_CONFIG_ENABLED=false
DIAGNOSTIC_CONFIG_REQUIRE_ADMIN=true
DIAGNOSTIC_CONFIG_VERBOSE=false
DIAGNOSTIC_CONFIG_ADMIN_TOKEN=
DIAGNOSTIC_CONFIG_ALLOW_DEVICE_AUTH=false

# -----------------------------------------------------------------------------
# CORS / Web
# -----------------------------------------------------------------------------
# Leave empty for local testing. In production set explicit origins.
# Example: https://example.com,https://example.run.app
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Data backend execution profile
# -----------------------------------------------------------------------------
# Production default: DB mode
DATA_BACKEND=db
DB_REQUIRED=true
LOCAL_JSON_FALLBACK_ENABLED=false

# Startup preload behavior
STARTUP_PRELOAD_ENABLED=true
STARTUP_PRELOAD_COLLECTIONS=

# -----------------------------------------------------------------------------
# PostgreSQL / Cloud SQL
# -----------------------------------------------------------------------------
# Prefer DB_URL, or set host-based values below.
# DB_URL=postgresql://user:password@host:5432/dbname
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable
# DB_DATA_MODE=json

# -----------------------------------------------------------------------------
# Google Cloud Storage / Service Account
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_DATA_PREFIX=app-data
GOOGLE_CLOUD_STORAGE_PUBLIC=false

# Use either file path or JSON string. Do not commit real secrets.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Authentication placeholders (template only; optional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Upload / operation limits (template for deployment-level policy)
# -----------------------------------------------------------------------------
# These are policy placeholders. Enforce in app/proxy if needed.
MAX_UPLOAD_MB=200
MAX_REQUEST_BODY_MB=250

# -----------------------------------------------------------------------------
# Operations / backup
# -----------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
DB_BACKUP_DIR=db/backups
