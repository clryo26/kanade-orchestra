# Google Cloud Storage / Cloud Run
# Grant the Cloud Run service account Storage Object Admin on this bucket.
GOOGLE_CLOUD_STORAGE_BUCKET=kanade-storage

# Set true only when uploaded recordings should be public by object URL.
GOOGLE_CLOUD_STORAGE_PUBLIC=false

# Local development with a service account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
PORT=8000

# Uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.wav,.mp3

# Audio conversion
AUDIO_BITRATES=128,192,320
DEFAULT_BITRATE=192
AUDIO_FORMAT=mp3

# Paths
UPLOAD_DIRECTORY=src/uploads
DATA_DIRECTORY=src/data
STATIC_DIRECTORY=src/static

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
