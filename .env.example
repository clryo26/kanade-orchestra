# Google Drive / Cloud Run
# Share the target Drive folder with the Cloud Run service account as Editor.
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_DRIVE_PERMISSION_TYPE=anyone
GOOGLE_DRIVE_PERMISSION_ROLE=reader

# Restrict Drive links to a Google Workspace domain instead of anyone-with-link.
# GOOGLE_DRIVE_PERMISSION_TYPE=domain
# GOOGLE_DRIVE_PERMISSION_DOMAIN=example.org

# Local development with a service account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
PORT=8000

# Uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.wav,.mp3

# Audio conversion
AUDIO_BITRATES=128,192,320
DEFAULT_BITRATE=192
AUDIO_FORMAT=mp3

# Paths
UPLOAD_DIRECTORY=src/uploads
DATA_DIRECTORY=src/data
STATIC_DIRECTORY=src/static

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
